# LLM Configuration for crypto-bot
# Copy to .env and fill in values (never commit .env!)

# Base URL for LLM API (OpenAI compatible)
LLM_BASE_URL=https://api.openai.com/v1

# Model to use (e.g., gpt-3.5-turbo, gpt-4, or local model endpoint)
LLM_MODEL=gpt-3.5-turbo

# API key for authentication
LLM_API_KEY=your_api_key_here

# Optional: Timeout in seconds for LLM requests
LLM_TIMEOUT=30

# Optional: Enable LLM feature (set to 1 to enable, 0 to disable)
ENABLE_LLM=0

# ---------------------------------------------------------------------------
# Execution Mode (DEMO / REAL)
# ---------------------------------------------------------------------------
# MODE=demo  -> observacao only, sem execucao de ordens (default)
# MODE=real  -> PaperEngine exec a preco live Binance (requer ALLOW_LIVE_TRADING=1)
MODE=demo

# ALLOW_LIVE_TRADING=1 -> libera REAL mode (execution paper). Default 0 (bloqueado).
ALLOW_LIVE_TRADING=0