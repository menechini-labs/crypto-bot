# ---------------------------------------------------------------------------
# Endpoint: análise do agente
# ---------------------------------------------------------------------------


@app.post("/api/analysis")
async def trigger_analysis(payload: dict[str, Any]) -> dict[str, Any]:
    """Recebe resultado de backtest e retorna análise do agente."""
    bt_data = payload.get("backtest")
    if not bt_data:
        raise HTTPException(400, "Campo 'backtest' obrigatorio")
    result: AnalysisResult = analyze_backtest(bt_data)
    return {"status": "ok", "analysis": result.to_dict()}


# ---------------------------------------------------------------------------
# Endpoint: analise de reflexao (ReflectionAgent)
# ---------------------------------------------------------------------------


@app.post("/api/reflection")
async def trigger_reflection(payload: dict[str, Any]) -> dict[str, Any]:
    """Recebe trades fechados e retorna reflexao estruturada."""
    trades = payload.get("trades", [])
    if not trades:
        raise HTTPException(400, "Campo 'trades' obrigatorio com lista de trades")
    regime = payload.get("regime", "unknown")
    strategy = payload.get("strategy", "unknown")
    symbol = payload.get("symbol", "unknown")
    reflection = reflect_trades(trades, regime=regime, strategy=strategy, symbol=symbol)
    save_reflection(reflection)
    return {"status": "ok", "reflection": reflection}


@app.get("/api/reflections")
async def get_reflections(limit: int = Query(10, ge=1, le=50)) -> dict[str, Any]:
    """Retorna historico de reflexoes salvas."""
    return {"status": "ok", "reflections": load_reflections(limit=limit)}


# ---------------------------------------------------------------------------
# Endpoint: download do projeto (.zip)
# ---------------------------------------------------------------------------


@app.get("/download/project")
async def download_project() -> FileResponse:
    tmp_zip = "/tmp/crypto-bot-project.zip"
    if os.path.exists(tmp_zip):
        os.remove(tmp_zip)

    root = os.getcwd()
    with zipfile.ZipFile(tmp_zip, "w", zipfile.ZIP_DEFLATED) as z:
        for dirpath, _dirnames, filenames in os.walk(root):
            if "node_modules" in dirpath or ".venv" in dirpath or "__pycache__" in dirpath:
                continue
            for f in filenames:
                fp = os.path.join(dirpath, f)
                arcname = os.path.relpath(fp, root)
                z.write(fp, arcname)

    return FileResponse(tmp_zip, media_type="application/zip",
                        filename="crypto-bot-project.zip")


# ---------------------------------------------------------------------------
# Factory & entrypoint
# ---------------------------------------------------------------------------


def create_app() -> FastAPI:
    return app


if __name__ == "__main__":
    if uvicorn is None:
        print("Instale dependencias: pip install uvicorn")
        raise SystemExit(1)
    uvicorn.run(app, host="0.0.0.0", port=8000)
